{
  "name": "dfo-dps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DFO Online combat DPS and build lab: read a save, model the game's combat core, rank stats, weapons, enchants and boss traits.",
  "bin": {
    "dfo-dps": "bin/dfo-dps.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:differential": "node --test test/differential.test.js",
    "test:golden": "node --test test/golden-upstream.test.js",
    "test:invariants": "node --test test/invariants.test.js",
    "test:vendor": "node --test test/vendor-manifest.test.js",
    "vendor:verify": "node tools/vendor-upstream.mjs --verify",
    "vendor:list": "node tools/vendor-upstream.mjs --list",
    "vendor:parity": "node tools/vendor-parity.mjs",
    "report": "node bin/dfo-dps.js report"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
